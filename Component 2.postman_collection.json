    {
      "name": "Policies",
      "item": [
        {
          "name": "List Policies",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/policies",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "policies"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Create or Upsert Policy",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"policy_name\": \"redirect-service-a-to-c\",\n  \"namespace\": \"test-services\",\n  \"frontend\": {\n    \"service\": \"service-a\",\n    \"port\": 5000\n  },\n  \"telemetry\": {\n    \"metric\": \"rtt_us\",\n    \"violation_threshold\": 2500,\n    \"monitor_pod_contains\": \"service-a\"\n  },\n  \"action\": {\n    \"type\": \"redirect\",\n    \"backend_selector\": \"app=service-c\",\n    \"backend_port\": 5003,\n    \"protocol\": \"TCP\",\n    \"ttl_seconds\": 300,\n    \"strategy\": \"all\",\n    \"backend_candidates_selector\": \"app=service-c\",\n    \"winner_label\": \"redirect-winner=yes\"\n  }\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/policies",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "policies"
              ]
            },
            "description": "Creates or updates a policy in the new schema (frontend + telemetry + action)."
          },
          "response": []
        },
        {
          "name": "Get Policy",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/policies/{{POLICY_NAME}}",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "policies",
                "{{POLICY_NAME}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Evaluate Policy (run helper)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/policies/{{POLICY_NAME}}/evaluate",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "policies",
                "{{POLICY_NAME}}",
                "evaluate"
              ]
            },
            "description": "Runs apply-local-redirect.sh with the stored rule and records status/history."
          },
          "response": []
        },
        {
          "name": "Expire Policy",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/policies/{{POLICY_NAME}}/expire",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "policies",
                "{{POLICY_NAME}}",
                "expire"
              ]
            },
            "description": "Deletes the LocalRedirectPolicy via the helper and marks the policy as expired."
          },
          "response": []
        },
        {
          "name": "Delete Policy",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/policies/{{POLICY_NAME}}",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "policies",
                "{{POLICY_NAME}}"
              ]
            },
            "description": "Removes the policy document and best-effort deletes the LRP via helper."
          },
          "response": []
        }
      ]
    }
