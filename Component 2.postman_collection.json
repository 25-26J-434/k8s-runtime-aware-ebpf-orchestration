				{
					"name": "Create Policy",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"policy_name\": \"redirect-service-a-to-c\",\n  \"namespace\": \"test-services\",\n  \"frontend\": {\n    \"service\": \"service-a\",\n    \"port\": 5000\n  },\n  \"telemetry\": {\n    \"metric\": \"dns_us\",\n    \"violation_threshold\": 1000,\n    \"monitor_pod_contains\": \"service-a\"\n  },\n  \"action\": {\n    \"type\": \"redirect\",\n    \"backend_selector\": \"app=service-c\",\n    \"backend_port\": 5003,\n    \"protocol\": \"TCP\",\n    \"ttl_seconds\": 300,\n    \"strategy\": \"best_pod\",\n    \"backend_candidates_selector\": \"app=service-c\",\n    \"winner_label\": \"redirect-winner=yes\"\n  }\n}"
						},
						"url": {
							"raw": "{{BASE_URL}}/api/policies",
							"host": [
								"{{BASE_URL}}"
							],
							"path": [
								"api",
								"policies"
							]
						},
						"description": "Create a policy (frontend + telemetry + action). Returns 409 if the policy already exists; use Update Policy instead."
					},
					"response": []
				},
				{
					"name": "Update Policy",
					"request": {
						"method": "PUT",
						"header": [
