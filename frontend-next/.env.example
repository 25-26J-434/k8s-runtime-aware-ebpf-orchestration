# Server-only. Never prefix with NEXT_PUBLIC_.
BACKEND_API_URL=http://localhost:8080
# Optional: separate services; default to BACKEND_API_URL.
ROUTING_API_URL=
SCALING_API_URL=
# Server-side proxy timeout (ms)
BACKEND_TIMEOUT_MS=15000
# Optional WebSocket gateway origin (e.g. wss://console.example.com). Empty = same origin.
NEXT_PUBLIC_WS_ORIGIN=
